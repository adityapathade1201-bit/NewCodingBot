        "import numpy as np\n",
        "\n",
        "def get_3x3_array(name):\n",
        "    print(f\"Enter the elements for {name} (3 rows, 3 space-separated integers per row):\")\n",
        "    elements = []\n",
        "    for i in range(3):\n",
        "        row = list(map(int, input().split()))\n",
        "        elements.append(row)\n",
        "    return np.array(elements)\n",
        "\n",
        "# 1. Input Format: Prompt user for two 3x3 arrays\n",
        "arr1 = get_3x3_array(\"Array 1\")\n",
        "arr2 = get_3x3_array(\"Array 2\")\n",
        "\n",
        "# 2. Perform Stacking Operations\n",
        "# Horizontal Stacking: Side-by-side\n",
        "h_stack = np.hstack((arr1, arr2))\n",
        "\n",
        "# Vertical Stacking: One below the other\n",
        "v_stack = np.vstack((arr1, arr2))\n",
        "\n",
        "# 3. Output Format: Display results\n",
        "print(\"\\nHorizontal Stack (side-by-side):\")\n",
        "print(h_stack)\n",
        "\n",
        "print(\"\\nVertical Stack (one below the other):\")\n",
        "print(v_stack)\n"
